database/*.db
database/*.db-wal
database/*.db-shm
database/journal.key
*.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
